general {
        colors = true
        interval = 5
}

order += "volume capture"
order += "volume master"
order += "disk /"
order += "battery 0"
order += "load"
order += "tztime local"

volume capture {
    format = "Mic: %volume"
    device = "default"
    mixer = "Capture"
    mixer_idx = 0
}

volume master {
    format = "Volume: %volume"
    format_muted = "Muted"
    device = "default"
    mixer = "Master"
    mixer_idx = 0
}

battery 0 {
    format = "%status %percentage %remaining"
    last_full_capacity = true
    integer_battery_capacity = true
}

tztime local {
    format = "%Y-%m-%d %H:%M:%S"
}

load {
    format = "%1min"
}

disk "/" {
    format = "%avail"
}
