#!/usr/bin/env bash

if ! [ -x  "$(command -v stow)" ]; then
    echo 'Stow not found! Installing...'
    sudo apt-get update && sudo apt-get install stow -y
fi

STOW_FOLDERS='zsh,nvim,starship,clangd,claude,gemini,hyprland,alacritty,tmux'

HOME=/home/serein

DOTFILES_HOME="$HOME/.dotfiles"

pushd "$DOTFILES_HOME"
for folder in $(echo $STOW_FOLDERS | sed 's/,/ /g')
do
	echo "Adding $folder"
	stow $folder -t $HOME -v
done
popd

ln -s "$DOTFILES_HOME/templates" "$DOTFILES_HOME/nvim/.config/nvim/"
